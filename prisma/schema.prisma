// SplitTab — money is ALWAYS integer cents. Exchange rates are scaled
// integers (rate * 1_000_000). No Float/Decimal for money or rates.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model User {
  id                       String         @id @default(cuid())
  name                     String
  email                    String         @unique
  // Null for placeholder ("invited by email") users until they sign up and
  // claim the account by setting a password.
  passwordHash             String?
  isPlaceholder            Boolean        @default(false)
  // Null until the user proves ownership of the email via the verification
  // link. Login is blocked while null (for accounts with a password).
  emailVerifiedAt          DateTime?
  isPro                    Boolean        @default(false)
  receiptStorageUsedBytes  BigInt         @default(0)
  receiptStorageQuotaBytes BigInt         @default(10737418240) // 10 GiB
  defaultCurrency          String         @default("USD")
  createdAt                DateTime       @default(now())
  sessions                 Session[]
  memberships              GroupMember[]
  paidExpenses             Expense[]      @relation("PaidBy")
  splits                   ExpenseSplit[]
  assignedItems            ExpenseItem[]
  defaultSplits            DefaultSplit[] @relation("SplitOwner")
  defaultSplitsAsOther     DefaultSplit[] @relation("SplitOther")
  tripPassesGranted        TripPass[]     @relation("TripPassGrantor")
  activities               Activity[]
  activitySubjects         Activity[]             @relation("ActivitySubject")
  friendshipsAsA           Friendship[]   @relation("FriendshipA")
  friendshipsAsB           Friendship[]   @relation("FriendshipB")
  verificationTokens       EmailVerificationToken[]
  resetTokens              PasswordResetToken[]
  trustedDevices           TrustedDevice[]
  loginChallenges          LoginChallenge[]
  settlementsSent          Settlement[]   @relation("SettlementFrom")
  settlementsReceived      Settlement[]   @relation("SettlementTo")
}

model Session {
  id        String   @id @default(cuid())
  // Only the SHA-256 hash of the bearer token is stored; the raw token lives
  // exclusively in the user's httpOnly cookie.
  tokenHash  String   @unique
  userId     String
  // Absolute expiry: 30 days from creation. Idle expiry: 7 days without use
  // (lastSeenAt is refreshed on use, throttled to one write per hour).
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, hashed email tokens. Only the SHA-256 hash of the token is
// stored; the raw token travels in the emailed link. Verification: 24h
// expiry. Password reset: 1h expiry, and using one revokes all sessions.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per login/signup attempt, for DB-backed rate limiting.
// Login: 5 failures for an email within 15 minutes -> 15-minute lockout.
// Signup: max 10 attempts per IP per hour.
model LoginAttempt {
  id        String   @id @default(cuid())
  kind      String // "login" | "signup"
  email     String
  ip        String
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, kind, createdAt])
  @@index([ip, kind, createdAt])
}

// Trusted devices for the new-device login challenge. A device is the
// SHA-256 of the browser's user-agent string (the raw UA is kept only for
// display in Settings). Location fields hold the LAST seen geo (from the
// platform's IP-geo headers); a login from a trusted device whose city or
// country changed triggers a "new location" alert email.
model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  userAgent   String
  ipAddress   String
  city        String
  region      String
  country     String
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  // R9: trust expires server-side (90 days, sliding on use) — the cookie
  // alone living 400 days must not keep a stale row valid forever.
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A pending email-code challenge for a login from an untrusted device.
// Only the SHA-256 of the 6-digit code is stored; 10-minute expiry, max 5
// attempts, single-use.
model LoginChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  userAgent  String
  ipAddress  String
  city       String
  region     String
  country    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Friendship {
  id        String           @id @default(cuid())
  // Pair is normalized: userAId < userBId (string compare) so each unordered
  // pair can only be stored once.
  userAId   String
  userBId   String
  status    FriendshipStatus @default(ACCEPTED)
  // Who sent the friend request (for PENDING rows); null for friendships
  // created implicitly by group co-membership.
  requestedById String?
  // Who blocked whom (for BLOCKED rows): the blocker; the other party is
  // silently prevented from re-requesting or re-adding.
  blockedById   String?
  createdAt DateTime         @default(now())
  userA     User             @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User             @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Group {
  id            String         @id @default(cuid())
  name          String
  type          String         @default("other") // apartment | house | trip | couple | other
  baseCurrency  String         @default("USD")
  createdAt     DateTime       @default(now())
  members       GroupMember[]
  expenses      Expense[]
  settlements   Settlement[]
  defaultSplits DefaultSplit[]
  tripPasses    TripPass[]
  activities    Activity[]
}

enum GroupMemberStatus {
  INVITED
  MEMBER
  // R10: a declined invitation is remembered — the row stays so the
  // person cannot be re-invited to the same group over and over.
  DECLINED
}

model GroupMember {
  userId      String
  groupId     String
  status      GroupMemberStatus @default(MEMBER)
  invitedById String?
  // R11: an invitation suppressed because of a block still shows as
  // "pending" to the inviter (so the block is not revealed), but it is
  // never surfaced to the invitee anywhere.
  inviteSuppressed Boolean      @default(false)
  joinedAt    DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model Expense {
  id            String         @id @default(cuid())
  // Null groupId = a non-group ("friend") expense; participants are defined
  // by the ExpenseSplit rows (payer + selected friend(s)).
  groupId       String?
  description   String
  amountInCents Int
  currency      String         @default("USD")
  paidById      String
  category      String         @default("General")
  notes         String?
  date          DateTime       @default(now())
  createdAt     DateTime       @default(now())
  // N5: expenses are voided, never hard-deleted — the row (and its splits)
  // stays as the audit trail but stops counting toward every balance.
  voidedAt      DateTime?
  voidedById    String?
  receiptId     String?        @unique
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy        User           @relation("PaidBy", fields: [paidById], references: [id])
  receipt       Receipt?       @relation(fields: [receiptId], references: [id])
  splits        ExpenseSplit[]
  items         ExpenseItem[]

  @@index([groupId])
  @@index([paidById])
}

model ExpenseSplit {
  expenseId         String
  userId            String
  amountOwedInCents Int
  expense           Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
}

model ExpenseItem {
  id               String  @id @default(cuid())
  expenseId        String
  description      String
  amountInCents    Int
  assignedToUserId String?
  expense          Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  assignedTo       User?   @relation(fields: [assignedToUserId], references: [id])

  @@index([expenseId])
}

model Receipt {
  id            String   @id @default(cuid())
  filePath      String
  fileSizeBytes BigInt   @default(0)
  uploadedAt    DateTime @default(now())
  expense       Expense?
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  VOIDED
  // R6: a party asked to void a CONFIRMED settlement; it keeps counting
  // until the OTHER party agrees (then VOIDED) or declines (CONFIRMED).
  VOID_REQUESTED
}

model Settlement {
  id            String           @id @default(cuid())
  fromUserId    String // the payer of the settlement (the one who owed)
  toUserId      String // the receiver
  amountInCents Int
  currency      String           @default("USD")
  // N3: a settlement counts toward balances only once the OTHER party
  // confirms it. Existing rows predate confirmation and keep counting
  // (hence the CONFIRMED default); new rows are created PENDING.
  status        SettlementStatus @default(CONFIRMED)
  recordedById  String? // who entered it; the other party must confirm
  voidRequestedById String? // R6: who asked to void a confirmed settlement
  // Null = friend-level settlement; set = settles within that group.
  groupId       String?
  createdAt     DateTime         @default(now())
  fromUser      User     @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User     @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([groupId])
}

model DefaultSplit {
  id          String  @id @default(cuid())
  userId      String
  groupId     String?
  otherUserId String?
  percentage  Int // 0-100, owner's share percentage vs. the other user / group default
  user        User    @relation("SplitOwner", fields: [userId], references: [id], onDelete: Cascade)
  group       Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  otherUser   User?   @relation("SplitOther", fields: [otherUserId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id                String @id @default(cuid())
  key               String @unique
  enabledForUserIds Json   @default("[]")
}

model TripPass {
  id              String   @id @default(cuid())
  grantedByUserId String
  groupId         String
  grantedAt       DateTime @default(now())
  expiresAt       DateTime
  grantedBy       User     @relation("TripPassGrantor", fields: [grantedByUserId], references: [id], onDelete: Cascade)
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model CurrencyRate {
  id           String @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rateScaled   Int // rate * 1_000_000, integer only

  @@unique([fromCurrency, toCurrency])
}

model Activity {
  id        String   @id @default(cuid())
  // Null groupId = non-group (friend) activity.
  groupId   String?
  userId    String?
  type      String
  // R1: `message` is a PII-free fallback string only. Names and emails
  // are NEVER baked into it — the people involved are stored as ids
  // (userId = actor, subjectId = the other party) plus non-PII params
  // in `data`, and the display text is rendered from the CURRENT user
  // rows at read time. A deleted account's row is tombstoned to
  // "Deleted user", so feeds update themselves with no text scrubbing.
  message   String
  subjectId String?
  data      Json?
  createdAt DateTime @default(now())
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  subject   User?    @relation("ActivitySubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}
