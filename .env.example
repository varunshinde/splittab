DATABASE_URL="postgresql://splitwise:splitwise_dev_only@localhost:5432/splitwise"
# Receipt image storage (production on Vercel): set this to the read/write
# token of a Vercel Blob store and receipt uploads go to Vercel Blob.
# Leave empty/unset for local dev — uploads then fall back to public/uploads.
# This is a dummy placeholder, NOT a real token — never commit a real one.
BLOB_READ_WRITE_TOKEN=

# Email (verification + password reset) via Resend.
# RESEND_API_KEY: from resend.com. Without it, dev mode logs emails (with
# links) to the server console; production signup will report the
# verification email as unavailable instead of pretending it sent.
# RESEND_FROM: must be a verified domain sender in production; the default
# onboarding@resend.dev test sender only delivers to the Resend account
# owner's own email address.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Public base URL for emailed links (falls back to VERCEL_URL, then localhost:3000).
NEXT_PUBLIC_APP_URL=
